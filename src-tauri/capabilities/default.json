{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and SQL access",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:path:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "fs:default",
    "fs:allow-copy-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPCONFIG" },
        { "path": "$APPCONFIG/**" },
        { "path": "F:/SpectrumProBackups" },
        { "path": "F:/SpectrumProBackups/**" }
      ]
    }
  ]
}
