{
  "productName": "SpectrumPro",
  "version": "1.0.0",
  "identifier": "com.spectrumpro.management.system",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "npm run copy:webview2-loader",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spectrum Pro Management",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SpectrumPro",
    "category": "Business",
    "shortDescription": "Paint business management — inventory, sales, reports, and backups.",
    "longDescription": "Spectrum Pro is a desktop paint-management system for inventory, customers, purchases, sales, payments, reports, multi-drive backup, and access control.",
    "resources": {
      "patches/webview2-com-sys/x64/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
